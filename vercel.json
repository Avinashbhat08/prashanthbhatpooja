{
  "buildCommand": "npm --prefix client run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health.js"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/auth/login.js"
    },
    {
      "source": "/api/auth/register",
      "destination": "/api/auth/register.js"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/auth/logout.js"
    },
    {
      "source": "/api/auth/me",
      "destination": "/api/auth/me.js"
    },
    {
      "source": "/api/gallery",
      "destination": "/api/gallery.js"
    },
    {
      "source": "/api/gallery/:id",
      "destination": "/api/gallery.js?id=:id"
    },
    {
      "source": "/api/categories",
      "destination": "/api/categories.js"
    },
    {
      "source": "/api/categories/:id",
      "destination": "/api/categories.js?id=:id"
    },
    {
      "source": "/api/pooja-items",
      "destination": "/api/pooja-items.js"
    },
    {
      "source": "/api/pooja-items/:id",
      "destination": "/api/pooja-items.js?id=:id"
    },
    {
      "source": "/api/settings",
      "destination": "/api/settings.js"
    },
    {
      "source": "/api/pooja-requests",
      "destination": "/api/pooja-requests.js"
    },
    {
      "source": "/api/horoscope-requests/my",
      "destination": "/api/horoscope-requests.js?my=true"
    },
    {
      "source": "/api/horoscope-requests/:id/calculate",
      "destination": "/api/horoscope-requests.js?id=:id&action=calculate"
    },
    {
      "source": "/api/horoscope-requests/:id/review",
      "destination": "/api/horoscope-requests.js?id=:id&action=review"
    },
    {
      "source": "/api/horoscope-requests/:id/approve",
      "destination": "/api/horoscope-requests.js?id=:id&action=approve"
    },
    {
      "source": "/api/horoscope-requests/:id/reject",
      "destination": "/api/horoscope-requests.js?id=:id&action=reject"
    },
    {
      "source": "/api/horoscope-requests/:id",
      "destination": "/api/horoscope-requests.js?id=:id"
    },
    {
      "source": "/api/horoscope-requests",
      "destination": "/api/horoscope-requests.js"
    },
    {
      "source": "/api/notifications/read-all",
      "destination": "/api/notifications.js?id=read-all"
    },
    {
      "source": "/api/notifications/:id/read",
      "destination": "/api/notifications.js?id=:id"
    },
    {
      "source": "/api/notifications",
      "destination": "/api/notifications.js"
    },
    {
      "source": "/((?!api/|gallery/|uploads/|prashanth-bhat.jpg|logo.svg|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
