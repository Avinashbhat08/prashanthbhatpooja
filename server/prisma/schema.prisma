datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String                    @id @default(uuid())
  name              String
  email             String                    @unique
  passwordHash      String
  role              String                    @default("USER") // "ADMIN" or "USER"
  isActive          Boolean                   @default(true)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  poojaRequests     PoojaRequest[]
  horoscopeRequests HoroscopeRequest[]
  marriageRequests  MarriageMatchingRequest[]
  muhurtaRequests   MuhurtaRequest[]
  notifications     Notification[]
}

model PoojaCategory {
  id          String      @id @default(uuid())
  nameEnglish String
  nameKannada String
  isActive    Boolean     @default(true)
  items       PoojaItem[]
}

model PoojaItem {
  id              String        @id @default(uuid())
  nameEnglish     String
  nameKannada     String
  categoryId      String
  category        PoojaCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  defaultQuantity String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model GalleryImage {
  id             String   @id @default(uuid())
  imageUrl       String
  captionEnglish String
  captionKannada String
  category       String   @default("Pooja Ceremonies")
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model PoojaRequest {
  id            String             @id @default(uuid())
  userId        String?
  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  poojaName     String
  poojaDate     String
  poojaTime     String
  personName    String
  gothra        String?
  nakshatra     String?
  contactNumber String?
  location      String?
  notes         String?
  createdAt     DateTime           @default(now())
  items         PoojaRequestItem[]
}

model PoojaRequestItem {
  id                      String       @id @default(uuid())
  poojaRequestId          String
  poojaRequest            PoojaRequest @relation(fields: [poojaRequestId], references: [id], onDelete: Cascade)
  poojaItemId             String?
  itemNameEnglishSnapshot String
  itemNameKannadaSnapshot String
  quantity                String?
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model HoroscopeRequest {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  personName        String
  dateOfBirth       String
  timeOfBirth       String
  birthPlace        String
  gender            String?
  contactNumber     String
  preferredLanguage String    @default("en")
  notes             String?
  status            String    @default("SUBMITTED")
  // "SUBMITTED" | "UNDER_REVIEW" | "CALCULATION_COMPLETED" | "PENDING_APPROVAL" | "APPROVED" | "REJECTED"
  assignedReviewer  String?
  calculationData   String?
  doshaAnalysis     String?
  remedies          String?
  purohitComments   String?
  approvedBy        String?
  approvedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Notification {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  horoscopeRequestId String?
  titleEnglish        String
  titleKannada        String
  messageEnglish      String
  messageKannada      String
  type                String   @default("INFO")
  isRead              Boolean  @default(false)
  createdAt           DateTime @default(now())
}

model MarriageMatchingRequest {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brideName         String
  brideDob          String
  brideTob          String
  bridePlace        String
  brideGender       String    @default("FEMALE")
  groomName         String
  groomDob          String
  groomTob          String
  groomPlace        String
  groomGender       String    @default("MALE")
  contactNumber     String
  preferredLanguage String    @default("en")
  notes             String?
  status            String    @default("SUBMITTED") // "SUBMITTED" | "UNDER_REVIEW" | "CALCULATION_COMPLETED" | "APPROVED" | "REJECTED"
  calculationData   String?   // JSON of Ashta Koota score, 8 kootas, Manglik, Rajju, Vedha
  purohitComments   String?
  approvedBy        String?
  approvedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model MuhurtaRequest {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType           String
  preferredLocation   String
  startDate           String
  endDate             String
  timeRangePreference String?
  contactNumber       String
  preferredLanguage   String    @default("en")
  notes               String?
  status              String    @default("SUBMITTED") // "SUBMITTED" | "UNDER_REVIEW" | "APPROVED" | "REJECTED"
  candidateMuhurtas   String?   // JSON of candidate Muhurta dates, timings, panchang, reasons
  purohitComments     String?
  approvedBy          String?
  approvedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}



